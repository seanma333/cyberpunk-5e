# macOS
.DS_Store

# LevelDB runtime files (generated by Foundry when loading packs)
packs/**/*.ldb
packs/**/*.log
packs/**/LOG
packs/**/LOG.old
packs/**/LOCK
packs/**/CURRENT
packs/**/MANIFEST-*
packs/**/*.sst
packs/**/*.tmp

# Unpacked pack sources (generated by `fvtt package unpack`)
# Authored sources live in src/packs/ and are compiled into packs/ via `npm run pack:all`
packs/**/_source/

# Node
node_modules/

# Build output (if ever added)
dist/

# Temporary / working files
tmp/
