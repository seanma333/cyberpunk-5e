{
  "name": "Corporate",
  "type": "background",
  "img": "modules/cyberpunk-5e/assets/background_icons/corporate.png",
  "system": {
    "description": {
      "value": "<p><strong style=\"font-weight:normal\" id=\"docs-internal-guid-567fb833-7fff-a53b-19a1-4eeb5291d620\">Corporations hold the greatest power in this world. You've always known this, and in order to have a piece of that power, you joined in the struggle to climb the corporate ladder. Whether you became a board member, a high-ranking executive, or even just a low-level employee, gaining even a small amount of clout in the company would mean you were set for life, so long as you kept working in the interests of the company. So what happened? How did you fall off the ladder and land in the streets?</strong></p><hr /><p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><strong>Skill Proficiencies: </strong>Insight, plus your choice of Persuasion or Deception</p><p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><strong>Tool Proficiencies: </strong>None</p><p dir=\"ltr\" style=\"line-height:1.38;margin-top:0pt;margin-bottom:0pt\"><strong>Languages: </strong>Two of your choice</p><p><strong>Equipment: </strong>A set of fine clothes, a smartphone, an award from your company, and a cryptostick with 1500 cp</p><p><strong>Feature: </strong>@UUID[Compendium.cyberpunk-5e.cyberpunk-backgrounds.Item.wgBfRw8ufjZtmkWi]{Corporate Etiquette}</p>",
